// schema.dbml — 2026-10-04 v2.2 (논리 재설계안, 17개 표)
// 계산 단위/결측/근거 확장. 상세 계약: data-model.md, scoring-and-population.md.
// v2.2(이슈 #42): 채점·평가 표 4개 연기(score_dependency, evaluation_run, evaluation_response, analysis_target_member), analysis_target을 score에 병합(결정 대기 A),
//       추출 키를 원본 파일 x 파서 버전으로 변경, 표 2개 추가(llm_field_extraction, source_watermark), 채울 수 없는 칼럼 제거, 코드 체계별 두 칼럼(결정 대기 E).
//       상세 변경표와 결정 대기별 반대 결정 시 범위: data-model.md 「v2.2」.
// v2.1: 추출 run/채점 run 분리(run_kind, upstream_run_id), 공식 run 마커(is_official), population_snapshot 유일키 수정, 상태값 enum 통일, metric_definition.direction.
// 09-20 팀 결정: fund_key 고정, run_id 통일, population_snapshot 신설.
// 09-22: 실제 파일 계보·수집 실패·소스별 키를 담도록 구체화한 검토안.
// 새 칼럼·타입·제약은 팀 승인 완료를 뜻하지 않는다. 근거/잔여 결정: data-model.md 「미결」, records/phase1-erd/design-review-history.md.
// DB 제품, PK 물리 타입/발급 방식, decimal precision, 물리 인덱스는 2단계 데이터 파이프라인 Flow 설계·3단계 입출력 Schema 설계에서 확정.
// indexes의 pk/unique는 성능 인덱스 선택이 아니라 논리 무결성 제약이다.

//////////////////////////////////////////////////////////////////////////////
// Enum
//////////////////////////////////////////////////////////////////////////////

Enum product_category_enum {
  "펀드"
  "ETF"
  "ELS" [note: 'Phase 1 범위 밖(9차 미팅, 1차 구현은 펀드·ETF만). Phase 2 검토. 값은 유지']
}

Enum etf_confidence_enum {
  KRX_CONFIRMED [note: 'KRX 목록의 ETF와 포털 상품의 연결을 확인. 두 소스에 공통 종목코드가 없어 이름 규칙 또는 사람 확인으로 연결하며 방식·근거는 버전 고정한 대응표에 보존(matching-rules.md 「ETF 판정」)']
  NAME_ONLY [note: '2차 판정. "상장지수" 문자열 포함 = 후보 선별용. 누락 0/938이지만 "재현율 100%"로 읽지 않는다 — 붙지 않은 229건의 이름 표기는 미측정 (matching-rules.md 「ETF 판정」)']
  NOT_ETF [note: '비ETF로 확인된 상품. 이름에 상장지수가 없다는 이유만으로 부여하지 않음']
  PENDING [note: '대조 실패 또는 보류. 초기 감사 재검토 148건 중 공식 자료 검토 153건을 확인했고 새 대응표에서 12건은 보류. 구조 검사만 통과한 932건은 NAME_ONLY, 이전 사람 확인 70건은 별도 유지. 현재 상태는 krx_link_review_v2.csv의 review_status로 판단. CDI 정규화 모집단 제외(matching-rules.md 「KRX 매칭 실패 처리」)']
}

Enum distributor_type_enum {
  "운용사"
  "판매사"
  "겸업" [note: '동일 법인이 운용·판매 역할을 함께 가짐']
  "미상"
}

Enum document_type_enum {
  "투자설명서"
  "간이투자설명서" [note: '09-20 정정(records/phase1-erd/dart-section-split.md): DART에서는 별도 raw_object가 아니라 본문 PDF 안의 절(요약 정보)로 존재. document_type 값으로 실제로 별도 문서 행이 생기는 경우가 있는지는 재검토 필요']
  "일괄신고서"
  "효력발생안내"
  "제재공시"
  "분쟁조정결정문"
  "금투협 수시공시" [note: '09-14 티켓 메모 반영, 신설. 공고 1건 = 문서 1건(클래스 단위 아님)']
  "경영유의공시" [note: '후보. 채택 미정 (records/phase1-erd/join-key-checks.md 「제재공시」) — 제재공시와 같은 번호 공간을 쓰는지도 미실측']
}

Enum body_format_enum {
  html
  json
  xml
  zip
  unknown
  pdf
  hwp5
  hwp3
  hwp_dist
  xml_only
}

Enum risk_grade_source_enum {
  SIMPLE_PROSPECTUS_TITLE [note: '간이투자설명서 표제의 공시 등급. 대표 등급의 우선 출처']
  PROSPECTUS_COVER [note: '투자설명서 표지 등급. 간이투자설명서가 없을 때 사용']
}

Enum match_method_enum {
  code
  string
  manual
}

Enum failure_reason_enum {
  PENDING_MASTER [note: '매칭 대상 마스터 미도착. 정상 대기 상태(DART가 금투협·공공데이터포털보다 6~18일 선행). 30일 재시도']
  AMBIGUOUS [note: '다중 후보 동점, 또는 코드 없는 소스에서 자동 확정 조건(matching-rules.md 「제재공시 법인 매칭」) 미충족. 수동 큐']
  NO_CANDIDATE [note: '후보 자체가 없음(신규상품·상장폐지 등). 주 1회 재시도']
  NO_CODE_IN_SOURCE [note: '분쟁조정·제재공시처럼 소스 구조상 코드·상품명이 구조상 없음. 재시도 대상 아님(구조적)']
  BELOW_THRESHOLD [note: '유사도 최소 기준값 미만(상품명 0.60, 판매사명 0.95 또는 단독후보/교차확인 미충족). 재시도 대상 아님']
  NORMALIZE_FAILED [note: '원문이 파싱 단계에서 깨져 정규화 자체 불가. storage-and-failure-rules.md 「추출 실패와 절 품질」과 연계']
  CLASS_GRADE_MISMATCH [note: 'v2.2 결정 대기(10월 4일 판단 항목). 클래스 위험등급이 펀드 대표 등급과 다름. 확인 대상. 클래스 product_id·대표 등급·클래스 등급·값 출처(운용사 공시/판매사/API)는 상세 JSON(resolution_note 안)에 기록(칼럼 추가 없음). 매칭 실패와 목적이 다르므로 별도 표로 분리할지는 결정 대기. 반대 결정 시 별도 상태 표로 이동(data-model.md 「v2.2」)']
}

Enum match_failure_status_enum {
  "미해결"
  "수동확인중"
  "보류"
  "해결"
  "대상외"
}

Enum file_role_enum {
  cover_html [note: 'DART 공개 뷰어 표지 HTML. document.xml API ZIP과 구분']
  cover_xml [note: '실제 XML 표지로 확인된 경우만 사용. document.xml API 응답은 ZIP이며 내부 구성 미확인']
  body_pdf [note: 'DART download.do 본문 PDF']
  api_response
  attachment
  prospectus [note: '금투협 첨부. 투자설명서 (records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 1: 금투협 중복 행」 반영)']
  prospectus_simple [note: '금투협 첨부. 간이투자설명서 (records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 1: 금투협 중복 행」 반영)']
  change_summary [note: '금투협 첨부. 변경대비표·규약 (records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 1: 금투협 중복 행」 반영)']
}

Enum collect_status_enum {
  success
  failed
  permanent_failed

  // 저장된 바이트 상태만 표현한다. 요청 결과 분류는 collection_attempt.outcome을 사용한다.
}

Enum raw_extract_status_enum {
  EXTRACT_OK [note: '추출 성공. 짧은 텍스트는 품질 플래그이며 추출 실패가 아님. 계산 적합성은 CDI 산식 담당 기준']
  EXTRACT_FAILED [note: '아래 세분 사유에 해당하지 않는 일반 실패 (09-20 확정). storage-and-failure-rules.md 「추출 실패와 절 품질」 판정 기준 중 하나 이상 위반. 자동 재시도 대상']
  EXTRACT_UNSUPPORTED_FORMAT [note: 'HWP 3.0. 분쟁조정 첨부 94건 실측. 자동 재시도 제외']
  EXTRACT_PARTIAL [note: '배포용 HWP(암호화), 7건. PrvText로 약 1,022자 부분 복구. 자동 재시도 제외']
  OCR_CANDIDATE [note: 'BMP 내장 4건. 보조 플래그. 재시도 대상']
  EXTRACT_NOT_APPLICABLE [note: '역할상 본문 추출 비대상으로 확인된 파일. 실패 아님']
  SECTION_BOUNDARY_NOT_FOUND [note: 'v2.2 신설. section 전용. 파일 추출은 성공했으나 이 절의 본문 경계(시작·끝 위치)를 찾지 못함. char_start/char_end NULL 허용. 일반 추출 실패와 구분(records/phase1-erd/dart-section-split.md)']

  // 성공 리터럴(EXTRACT_OK)과 일반 실패(EXTRACT_FAILED)는 09-20에 확정했다(7차 미팅).
  // 절 표(section)의 extract_status도 이 enum을 공유한다. 파일 단위(file_extraction)에는 SECTION_BOUNDARY_NOT_FOUND를 쓰지 않는다.
}

Enum parse_status_enum {
  PARSE_OK [note: '선택된 필수 파일 집합이 비어 있지 않고 모두 EXTRACT_OK. 실행별 집계']
  PARSE_PENDING [note: '선택·수집·추출 미완료']
  PARSE_NOT_APPLICABLE [note: 'CDI 비대상 문서. 실패율 분모에서 제외']
  PARSE_PARTIAL [note: '평가 완료 후 일부 EXTRACT_OK 또는 EXTRACT_PARTIAL 존재, 전부 OK는 아님']
  PARSE_FAILED [note: '평가 완료 후 OK/PARTIAL이 하나도 없음']

  // document별 file_extraction 집계 뷰(v2.2: 파일 x 파서 버전 기준, 사용한 파서 버전을 함께 지정). storage-and-failure-rules.md 「문서 파싱 상태」의 판정 우선순위 적용.
  // EXTRACT_NOT_APPLICABLE 파일(cover_xml 등 본문이 원래 없는 것)은 집계에서 뺀다.
}

//////////////////////////////////////////////////////////////////////////////
// Tables
//////////////////////////////////////////////////////////////////////////////

Table product {
  product_id int [pk, note: '내부 발급 서러게이트 키. 구체 자료형(int/bigint 등)·생성 방식은 2단계 데이터 파이프라인 Flow 설계 사안']
  short_code varchar(5) [note: '단축코드 5자리 영숫자([A-Z0-9]{5}). DART 표지 펀드코드 = 공공데이터포털 srtnCd(두 소스 코드 조인, records/phase1-erd/join-key-checks.md 「조인 키 확인 현황」). 펀드·ETF 1차 조인 키. 전역 유일 아님(전체 165,118종 중 4,899종=3.0% 중복) — 2015년 이후 설정분·상장지수 1,435건 범위에서는 안전. 겹치면 (asoStdCd 앞 6자리, short_code) 조합으로 확장(records/phase1-erd/join-key-checks.md 「srtnCd 비유일」)']
  kofia_fund_code varchar(12) [note: 'K55 체계 코드 12자리 = K55+운용사3+단축5+검증1. 결정 대기 E(기본값: 체계별 두 칼럼, 10월 4일). 채우는 소스 두 곳: 금투협 수시공시 코드와 공공데이터포털 asoStdCd 중 K55로 시작하는 값(ETF 대조 표본 1,373건 중 1,195건). 접두 3자로 분기(matching-rules.md 「코드 체계 분기」). 반대 결정(한 칸 병합 등) 시 이 칼럼과 standard_code 두 칼럼만 바뀜']
  standard_code varchar(12) [note: 'KR5/KRM 체계 협회표준코드 12자리. 공공데이터포털 asoStdCd 중 KR5·KRM으로 시작하는 값(같은 표본 178건)과 금투협 standardCd의 KR5·KRM 값. kofia_fund_code와 체계가 다름. 결정 대기 E']
  isu_cd varchar [note: '거래소 종목코드. ETF에만 값 존재(그 외 NULL). short_code와 잇는 코드성 수단이 없어 이름으로만 연결되고 완전일치 0.0%/포함매칭 80.4%(records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 2: ETF 이름 규칙」. ISU_CD와 srtnCd를 잇는 대응 소스 없음). 길이·형식은 문서에 근거 없어 미정']
  product_name text [not null, note: '포털 fndNm 원문. DART 표지 명칭은 매칭 근거에 별도 보존']
  product_name_normalized text [note: 'matching-rules.md 「상품명 정규화」 4단계(NFKC→공백 제거→(주)/주식회사 제거→유형괄호·호수·클래스 분리) 결과']
  product_category product_category_enum [note: '분류 미확정이면 NULL. 펀드/ETF로 강제 배정하지 않음']
  is_etf boolean [note: 'KRX_CONFIRMED=true, NOT_ETF=false, NAME_ONLY/PENDING=NULL']
  etf_confidence etf_confidence_enum [not null, note: 'records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 2: ETF 이름 규칙」 반영, 신설']
  fund_key varchar [ref: > fund_group.fund_key, note: '고정 식별자(09-20 결정). 묶음 미확정이면 NULL, 통계에서 사유와 함께 제외']
  risk_grade int [note: '1~6, 1이 최고위험. DART 투자설명서 표지 "N등급[문구]"에서 정규식(\\d)등급으로 추출. corp_code 조인이 아니라 문서→상품 경로로 채움. 위험등급 원천이 DART 하나만은 아닐 수 있음(금투협 첨부 PDF 본문에도 표기 확인, records/phase1-erd/source-profile.md 「값 표기」) — scoring-and-population.md 「알려진 분석 위험」의 위험등급 결측 논증 전제이므로 재검토 대상. 공시된 펀드 위험등급(1~6등급)을 그대로 쓰고 사람이 다시 매기지 않음(9차 미팅). 같은 펀드의 클래스끼리 등급이 다른 경우의 처리는 미정: 데이터 사이언스(다빈) 확인대기']
  manager_id int [ref: > distributor.distributor_id, note: '운용사/겸업 법인. 포털에 운용사 필드가 없어 매핑 전 NULL 허용']
  inception_date date [note: '포털 setpDt 설정일. 유효 달력일만 변환; 더미는 NULL과 원천 보존. 판매개시일과 다름. v2.2: 판매개시일·판매종료일 칼럼은 채울 수 없어 제거']
  fund_type varchar [note: '공공데이터포털 fndTp. scoring-and-population.md 「알려진 분석 위험」에서 위험등급의 보조 층화축 후보로만 확보. 코드 형식·길이 미정. 값 형식은 데이터 엔지니어링·인프라(주영) API 조회로 확인대기(9차 미팅)']
  product_class_code varchar [note: '공공데이터포털 prdClsfCd. 코드 형식·길이 미정. 값 형식은 데이터 엔지니어링·인프라(주영) API 조회로 확인대기(9차 미팅)']
  source_raw_object_id int [ref: > raw_object.raw_object_id, note: '현재 상품 값을 공급한 포털 응답 파일. basDt와 원천 행 키로 역추적']
  source_baseline_date date [note: '원천 basDt. 설정일/수집일과 구분']
  risk_grade_raw_object_id int [ref: > raw_object.raw_object_id, note: '현재 위험등급의 DART 표지 또는 금투협 첨부 근거. 과거 값은 실행 입력 manifest에 고정']
  valid_from date [note: 'SCD2 예비 칸(09-14 티켓 메모 반영, 신설). 물리화 여부는 2단계 데이터 파이프라인 Flow 설계 사안 — 지금은 이력을 두지 않으면 변경 이력이 영구 소실된다는 문제만 인지된 상태']
  valid_to date [note: 'SCD2 예비 칸. valid_from과 동일 사유']

  Note: '''
  단위 = 검증된 상품 클래스 하나. 단축코드는 중복 가능하며 클래스 식별자와 같지 않다.
  short_code·srtnCd가 모두 클래스 입자라
  펀드 단위로 잡으면 1차 조인 키가 유일하지 않게 된다(아키텍트 확정, 09-16).
  short_code는 조회 후보 키일 뿐 UNIQUE가 아니다. 중복은 전체 코드/운용사/클래스로 검증.
  표본에서 충돌이 적어도 자동 유일성 보장으로 해석하지 않는다. fund_key로 클래스를 펀드 단위로
  묶어 scoring-and-population.md의 CDI 정규화 모집단·최소표본 30건 판정에 쓴다.
  v2.2: 채울 수 없는 칼럼 4개 제거(판매개시일, 판매종료일, 공모 여부, finlife 상품코드). 판매 중 여부의 판단 근거는 미결(data-model.md 「미결」).
  ELS 식별 키는 아직 없다(data-model.md 「미결」) — ELS 전용 칼럼을 추가하지 않았다. ELS는 Phase 1 범위 밖(9차 미팅), Phase 2 검토. 주의: is_etf·
  etf_confidence를 문자열 규칙 하나로 판정하면 오탐이 14~30%다.
  '''
}

Table distributor {
  distributor_id int [pk, note: '내부 발급 서러게이트 키']
  kofia_sales_code varchar(6) [unique, note: '판매회사 마스터 saleCompCd. 200건 전부 6자리/유일. 운용사 코드와 별개']
  corp_code varchar [note: 'DART 법인 고유번호(공시 제출 법인=운용사). 원래 상품 표에 있던 것을 이관(문서→상품 경로로 위험등급을 채우기 위한 결정과 연동). document.corp_code와 값 체계가 같아 보이나 이 문서 어디에도 FK로 명시돼 있지 않아 관계선을 긋지 않았다(data-model.md 「ERD」의 그림에 넣지 않은 관계 1번). 8자리(09-30 목록 API 실측)']
  kofia_disclosure_company_code varchar(6) [unique, note: '금투협 전자공시 공시 목록의 운용사 코드 companyCd(예: A01021=한화자산운용, A01048=미래에셋자산운용). 현재 운용사 기준이라 합병·상호 변경을 반영. 공시 행을 적재할 때 채움. 표준코드 안 3자리 코드(kofia_mgmt_code)와 체계가 다름. 운용사 연결 1순위 키(matching-rules.md 「운용사 연결 순서」). 10월 4일 추가']
  kofia_mgmt_code varchar(3) [note: '금투협 운용사 코드 3자리 영숫자(예: 105=삼성자산운용, 301=미래에셋자산운용). 대응표 536건 = research/samples/kofia_mgmt_codes.csv']
  distributor_name text [not null, note: '원문명']
  distributor_name_normalized text [note: 'matching-rules.md 「법인명 정규화」 5단계(NFKC→구상호 치환→법인격 표기 제거→공백 제거→지점 표기 제거) 결과. 상품명 정규화 규칙을 쓰지 않는다 — 법인명에는 클래스 표기가 없고 대신 상호 변경이 있다']
  distributor_type distributor_type_enum [not null]

  Note: '''
  운용사·판매사·미상을 한 표에 두고 distributor_type으로 구분한다. 법인 실체는 같은
  종류라 표를 나눌 이유가 없지만, 상품과의 관계는 단일 FK로 담을 수 없어 아래
  product_distributor N:M 브릿지로 뺐다.
  주의: 운용사 536건 중 97건(18%)이 구상호를 갖고 그중 44건은 업종 접미사까지 바뀐다
  ("누림투자자문"→"누림자산운용") — 유사도만으로는 못 잇는다(matching-rules.md 「법인명 정규화」).
  미확인: corp_code ↔ kofia_mgmt_code 대응(문자열 매칭 1회 고정 필요, 536건 규모). 운용사 코드는 1:1이 아니다 — 대응표에 없는 값 7종은 10월 4일 정리(matching-rules.md 「대응표에 없는 운용사 코드」).
  '''
}

Table product_distributor {
  product_id int [ref: > product.product_id, not null]
  distributor_id int [ref: > distributor.distributor_id, not null]
  snapshot_month varchar(6) [not null, note: 'YYYYMM. 09-20 신설. 이 칸 없이 (product_id, distributor_id)로 upsert하면 매달 과거 판매 관계를 경고 없이 덮어쓴다']
  source_raw_object_id int [ref: > raw_object.raw_object_id, not null, note: '판매사별 펀드 API 응답. source_document_id가 NULL이어도 출처 보존']
  observed_date date [not null, note: '실제 조회 기준일 tmpV30/tmpV16. snapshot_month의 대표일 정책은 data-model.md 「적재 검증 규칙」 참조']
  source_document_id int [ref: > document.document_id, note: '이 연결을 알려준 문서. 확정된 현재 경로(금투협 전자공시 "판매사별 펀드보수비용" 코드 조회)에서는 명단이 문서가 아니라 별도 API 조회에서 오므로 항상 NULL이다(records/phase1-erd/join-key-checks.md 「판매회사 명단 소스」). 문서 경로가 추가되면 NULL 허용 여부를 재검토']

  indexes {
    (product_id, distributor_id, snapshot_month) [pk]
  }

  Note: '''
  자연키 = (product_id, distributor_id, snapshot_month) — snapshot_month가 없던 시절에는
  (product_id, distributor_id)만으로 upsert해 이력이 유실될 뻔했다.
  상품:판매사 N:M. 상품 표의 단일 distributor_id는 없애고 운용사만 product.manager_id로 남겼다.
  은행 채널 표본 ETF 0건, 증권사 채널(삼성증권) 6건 확인(09-22).
  표본 0건을 전체 ETF의 판매관계 부재로 해석하지 않는다.
  '''
}

Table document {
  document_id int [pk, note: '내부 발급 서러게이트 키']
  source varchar [not null, note: '소스/엔드포인트 이름공간. 7개: dart, kofia_disclosure, fss_sanction, fss_improvement, fss_dispute, data_go_fund(공공데이터포털 펀드상품기본정보), krx_etf_daily(KRX ETF 일별 매매정보). 뒤 두 소스는 API 스냅숏이라 document 행 없이 raw_object(document_id NULL)와 source_watermark에만 나온다']
  source_doc_key varchar [not null, note: 'source 안에서 유일한 원천 식별자. DART rcept_no, 금투협 4필드 해시. 제재공시는 emOpenNo가 아니라 후보 복합키, data-model.md 「문서와 소스별 키」 참조']
  source_key_payload text [not null, note: '키 생성 전 원천 필드 JSON. 제재 API 후보는 examMgmtNo/emOpenSeq/transCode/actGbn. 빈 키/충돌은 격리']
  source_record_payload text [note: '제재 13필드 등 원천 레코드 JSON. API 응답 파일의 원문도 별도 보존']
  action_date date [note: '제재 actReqDate. 공시 입력/접수 날짜와 다름']
  source_input_at timestamp [note: '제재 inputDate. 원문 문자열과 시간대 해석은 payload에 보존']
  rcept_no varchar(14) [note: 'DART 접수번호. DART 전용 칸(09-14 티켓 메모 반영) — 그 외 소스는 NULL. 14자리 숫자(09-30 목록 API 실측으로 확인, data-sources.md 「OPEN DART API」)']
  dcm_no varchar [note: 'DART 문서번호. download.do?dcmNo=로 본문 PDF를 받을 때 필요. DART 전용 칸. 길이 미정']
  corp_code varchar [note: 'DART 법인코드(제출 법인=운용사). distributor.corp_code와 값 체계가 같아 보이나 FK로 명시된 바 없어 관계선을 긋지 않았다(data-model.md 「ERD」의 그림에 넣지 않은 관계 1번). 8자리(09-30 목록 API 실측으로 확인)']
  document_type document_type_enum [not null]
  report_name text [note: 'DART 보고서명 원문(예: "[기재정정] 투자설명서"). document_type은 이 값에서 파생']
  report_base_date date [note: 'v2.2(10월 7일 10차 미팅 확정). 문서 작성기준일. 작성기준 항목 점검이 이 시점의 작성기준 판과 비교한다. 비교한 작성기준 판과 표 영역 구분은 칼럼 없이 파일(구조 manifest, 작성기준 판 버전 파일). 반대 결정 시 칼럼 제거 후 manifest로 이동']
  // v2.2: pblntf_detail_ty 제거. 목록 API 응답에 없고 요청 필터도 효과가 없어 채울 수 없다. 문서 종류는 report_name으로 판별.
  // 파일 형식은 raw_object.body_format에 둔다. 문서 하나에 HTML/PDF/HWP가 공존한다.
  distributor_id int [ref: > distributor.distributor_id, note: '상품 연결이 없는 문서(분쟁조정·제재공시 등)를 판매사 축에 붙이기 위한 칼럼. nullable. 분쟁조정은 판매사명도 마스킹이라 이 값조차 못 채운다 — "문서 표에만 존재하는 미연결 레코드"가 정상 상태다(records/phase1-erd/join-key-checks.md 「분쟁조정 마스킹」)']
  is_correction boolean [note: 'DART 구조로 판정. 미판정/금투협 연결 규칙 미확정은 NULL, false로 만들지 않음']
  lineage_id int [ref: > document.document_id, note: '같은 사건 최초 문서. 확인된 원본만 self; 원본 미도착/계보 미확정은 NULL']
  version_no int [note: '파생 칼럼(09-14 티켓 메모 반영, 신설). lineage 안에서 received_date 순번']
  is_current boolean [note: '파생 칼럼(09-14 티켓 메모 반영, 신설). 물리 칼럼으로 둘지는 2단계 데이터 파이프라인 Flow 설계의 이력 설계에서 결정']
  initial_submit_date date [note: '정정본이면 정정신고 요소에 적힌 최초제출일. 원본이면 received_date와 같다']
  received_date date [not null, note: '접수일자. 분쟁조정은 게시일로 채움. 금소법 시행(2021년) 이후 자료만 거르는 기준이라 필수 유지(9차 미팅). 현재 조사 스크립트 research/scripts/fetch_fss_dispute.py의 listing()은 게시일을 파싱하지 않음(수집기 미구현). 분석·리서치(민석) 확인대기, 2026-10-04']
  // parse_status는 document별 file_extraction 집계 뷰(파일 x 파서 버전 기준). 현재 상태로 과거 파서 결과를 덮어쓰지 않는다.

  indexes {
    (source, source_doc_key) [unique]
  }

  Note: '''
  단위 = "수집한 원천 문서 1건"(records/phase1-erd/initial-source-checks.md 「부록: Notion 티켓 메모 사본」). DART는 접수번호 단위, 금투협 수시공시는 공고
  1건 단위(클래스 단위 아님), 제재공시는 원천 제재 레코드 단위(후보 복합키 검증 필요), 분쟁조정은 게시글 번호 단위.
  자연키 = (source, source_doc_key).
  주의: 분쟁조정·제재공시·경영유의공시는 의도적으로 document_product 브릿지 행을 만들지
  않는다 — 응답에 상품을 가리키는 칸이 없거나(제재) 상품명이 마스킹(분쟁조정)이라
  매칭을 시도하면 실패 로그만 쌓이고 실패율이 실제보다 높게 나온다(matching-rules.md 「매칭 실패 기록」의 NO_CODE_IN_SOURCE). 매칭
  모듈은 이 document_type들을 매칭 대상에서 제외해야 한다.
  DART 공개 뷰어는 cover_html과 body_pdf를 수집한다. API ZIP은 별도이며 파일 수를 2개로 고정하지 않는다. 간이투자설명서는
  DART에서 별도 첨부가 아니라 본문 PDF 안의 절이다(09-20 정정, records/phase1-erd/dart-section-split.md) — document_type
  값으로서의 실제 사용 여부는 재검토 대상.
  '''
}

Table document_product {
  document_id int [ref: > document.document_id, not null]
  product_id int [ref: > product.product_id, not null]
  match_method match_method_enum [not null, note: 'matching-rules.md 「매칭 경로」의 3단 계단식(1차 코드 → 2차 정규화 펀드명 → 3차 운용사명+설정일) 중 어느 단에서 붙었는지']
  match_score decimal [note: '매칭 점수. 코드 매칭이면 1.0, 문자열 매칭이면 유사도. precision/scale은 문서에 근거 없어 미정']
  matched_at timestamp [not null]

  indexes {
    (document_id, product_id) [pk]
  }

  Note: '''
  문서 1건이 상품(클래스) 여러 건을 가리키는 1:N 브릿지. 이 1:N은 수시공시(uRptGb=O,
  tsCd 2OF…)에서만 실측됐다 — 표본 평균 3.02행/묶음. 정기공시(2RF…)는 평균 1.08행으로
  평균이 1에 가까워도 1:1 제약의 근거가 되지 않는다(records/phase1-erd/kofia-rows-and-etf-rule.md 「검증 1: 금투협 중복 행」).
  주의: 분쟁조정·제재공시·경영유의공시는 이 표에 행을 만들지 않는다(위 document 표 note
  참고). ELS의 매칭 키 자체가 미정이라(data-model.md 「미결」) ELS 행이 어떤 키로 이 표에 들어오는지
  규칙이 없다. ELS는 Phase 1 범위 밖(9차 미팅), Phase 2 검토.
  '''
}

Table section {
  section_id int [pk, note: '내부 발급 서러게이트 키. v2.2: 키가 추출 실행이 아니라 원본 파일 x 파서 버전이므로 같은 파서로 다시 추출하지 않는 한 값이 유지된다. 공개 ID로 쓸 때 run_id 동반이 필요 없다(schema-catalog.md 「공개 식별자 규칙」)']
  document_id int [ref: > document.document_id, not null]
  raw_object_id int [not null]
  parser_version varchar [not null, note: 'v2.2. 이 절을 만든 파서 버전. file_extraction과 같은 값. 같은 파일을 같은 파서 버전으로 추출한 결과가 이미 있으면 다시 추출하지 않는다']
  section_seq int [not null, note: '한 파일/파서 버전 안의 전역 순번. 부 안의 절 번호와 다름']
  part_seq int [note: '원문 부 번호. 요약 등 부 체계 밖 구간은 NULL']
  source_section_no varchar [note: '원문 절 번호. 부마다 반복되며 비숫자 번호도 보존']
  canonical_section_code varchar [note: 'v2.2 신설. 문서 간 같은 절을 묶는 정규 절 분류. 제4부 절 구성이 문서마다 다름(표본 9문서 중 7건 3절, 2건 6절, records/phase1-erd/dart-section-split.md). 값 규칙은 결정 대기 F(칼럼만 두고 값 규칙 미정). 분류 못 하면 NULL']
  section_kind section_kind_enum [not null, note: 'summary도 실제 원문 구간, 가짜 집계 절 생성 금지']
  char_start int [note: 'file_extraction의 canonical text 기준 0-based Unicode code point(글자 위치) 시작. 줄 번호가 아니다. SECTION_BOUNDARY_NOT_FOUND이면 NULL']
  char_end int [note: '같은 텍스트 기준 exclusive 끝. 성공한 절은 0 <= start < end <= text_length. SECTION_BOUNDARY_NOT_FOUND이면 NULL']
  quality_flags text [note: 'JSON 배열. SHORT_TEXT 등 계산 적합성 표시; 추출 실패와 구분']
  section_title text
  section_text text [note: 'canonical text의 [char_start,char_end) 구간. 실패 시 복구된 텍스트 또는 NULL. 지표용 전처리는 별도 버전으로 추적']
  extract_status raw_extract_status_enum [not null, note: '추출 성패. 짧다는 이유만으로 실패 처리하지 않는다(storage-and-failure-rules.md 「추출 실패와 절 품질」). 본문 경계를 못 찾은 절은 SECTION_BOUNDARY_NOT_FOUND']

  indexes {
    (raw_object_id, parser_version, section_seq) [unique]
  }
  Note: '''
  불변: EXTRACT_OK file_extraction에 딸린 section 행은 삭제·재발급하지 않는다(score·llm_field_extraction이 section_id를 참조. 적재 검증).
  점수를 절 단위로 저장하기 위한 전제 표(드릴다운: 문서 단위가 아니라 절 단위 점수).
  원본 파일과 파서 버전을 함께 참조한다. 같은 파일을 다른 파서 버전으로 처리하면 절을 새로 적재하고,
  같은 파서 버전이면 다시 추출하지 않는다(v2.2 수정 2). 번호가 반복되는 부/절과 별도 첨부를 섞지 않는다.
  '''
}

Table score {
  score_id int [pk, note: '내부 발급 서러게이트 키']
  run_id varchar [not null, ref: > pipeline_run.run_id, note: 'SCORE run']
  target_type target_type_enum [not null, note: 'target_type별로 대상 칼럼(section_id, document_id, fund_key) 중 정확히 하나만 채워짐(CHECK num_nonnulls(section_id, document_id, fund_key) = 1. DOCUMENT_PAIR는 Phase 2이며 현재 저장 불가. 적재 검증). v2.2 결정 대기 A(analysis_target 병합, 기본값). 계산 단위. 결정 대기 B10 채택: metric_definition.target_type과 같아야 함(아래 복합 FK로 강제)']
  target_key varchar(64) [not null, note: 'v2.2 병합. target_key 계약(data-model.md 「절과 점수 대상」 6번, 계약 버전 3): 종류/앵커/대표본 정책 버전의 정규 JSON SHA-256(data-model.md 「절과 점수 대상」 6번). run 안의 재시도 멱등성 키이며 run 간 동일 대상 탐지 키가 아님. 공개 ID로 쓰지 않음']
  section_id int [ref: > section.section_id, note: 'SECTION만 필수, 다른 유형은 NULL. 그 절의 파서 버전은 section.parser_version이며 run의 input_manifest가 고정한 파서 버전과 일치해야 함(적재 검증)']
  document_id int [ref: > document.document_id, note: 'DOCUMENT만 필수. 다른 유형은 NULL']
  fund_key varchar [ref: > fund_group.fund_key, note: 'FUND만 필수. 다른 유형은 NULL; 통계 연결은 실행 입력/모집단 manifest']
  metric_key varchar [not null, note: '불변 지표 버전. ASL/축값/CDI/백분위도 서로 다른 지표로 명시 가능. (metric_key, target_type) 복합 FK']
  assessor_key varchar [not null, note: 'deterministic 또는 config_manifest 안의 평가자/모델 설정 키. 재시도는 같은 키, 별도 평가자는 다른 키']
  result_status result_status_enum [not null]
  reason_code varchar [note: 'OK 이외에는 필수. ZERO_DENOMINATOR/SHORT_TEXT/UNAPPROVED_DEFINITION/INPUT_FAILED 등']
  raw_score decimal [note: 'OK일 때만 NOT NULL. 계산 불가를 0으로 대체하지 않는다']
  numerator decimal
  denominator decimal [note: '비율 지표 OK이면 양수. 분모 의미는 metric_definition에 고정']
  normalized_score decimal [note: '정규화 OK일 때만 값. 범위/방향은 지표 계약에 명시']
  normalization_status normalization_status_enum [not null, note: '원점수 성공과 별도 상태']
  normalization_reason varchar
  population_snapshot_id int [note: '같은 실행/지표의 모집단. 시도했으나 표본 미달인 경우도 연결 가능']
  score_payload text [not null, note: 'score_payload 계약 v2.2(target_key 계약과 별개): 항목별 충족/미충족/해당없음/판정불가, 적용수/평가완료수, 근거 위치 (section_id, char_start, char_end)(결정 B11 안 1; member_id·block_id 의존 제거), 「없음」 판정은 검사한 절 목록, 실제 가중치(파트 B 합산, 연기한 score_dependency 대신), 전처리/단위/커버리지. 파트 A는 항목 하나당 metric_key 하나, 파트 B는 축 1·2 합산 metric_key 하나(축 3은 파일럿 뒤 새 버전), 작성기준 항목 점검 4종은 파트 A 옆 별도 행(비교한 작성기준 판 기록). scoring-and-population.md 「고지 항목 판정」 참조']
  scored_at timestamp [not null]

  indexes {
    section_id
    document_id
    fund_key
    (run_id, target_key, metric_key, assessor_key) [unique, note: 'v2.2: 대상이 score에 병합되어 target_id 대신 target_key. 대상 칼럼이 NULL을 허용해 유일키에 앵커 칼럼을 직접 넣지 않았다']
  }

  Note: '''
  절/문서/문서쌍/펀드의 원자값·축값·최종값을 대상과 지표 버전으로 구분한다.
  v2.2: analysis_target 표를 이 표에 합쳤다(결정 대기 A). 반대로 결정되면 analysis_target 표 1개를 복원한다(data-model.md 「v2.2」).
  집계 입력의 실제 가중치는 score_payload 또는 metric_definition.definition_manifest에 기록한다(score_dependency 표는 연기).
  DOCUMENT_PAIR는 입력 파일 두 개를 가리킬 칼럼이 없다 — 문서쌍 지표는 Phase 2이므로 당장 만들지 않고, 만들 때 표를 정한다(data-model.md 「미결」).
  계획된 계산은 PENDING 행을 먼저 생성한다. 미계획과 실패/제외/미실행을 구분한다.
  기준일은 pipeline_run에서 조회한다. run_id는 SCORE run이다. 산식·평가자 설정·모집단 기준 변경은
  새 SCORE run. 파서·입력 스냅숏 변경은 새 EXTRACT run과 그것을 참조하는 새 SCORE run. 대시보드가 보여주는 점수는 is_official=true인 SCORE run의 것이다(data-model.md 「실행과 비교 모집단」).
  CHECK 및 교차 행 검증은 data-model.md 「적재 검증 규칙」의 계약이며 DBML FK만으로 전부 강제되지 않는다.
  '''
}

Table match_failure {
  failure_id int [pk, note: '내부 발급 서러게이트 키']
  run_id varchar [not null, ref: > pipeline_run.run_id, note: 'EXTRACT run(매칭은 추출 실행 소속)']
  target_type match_target_enum [not null, note: '매칭 대상 종류. score의 target_type_enum과 다른 개념']
  top1_candidate_distributor_id int [ref: > distributor.distributor_id]
  resolved_at timestamp
  resolution_note text
  source varchar [not null, note: '실패가 발생한 소스']
  attempted_key_value text [not null, note: '매칭을 시도한 키값. 코드 매칭 실패 시 코드, 문자열 매칭 실패 시 원문 상품명']
  normalized_value text [note: 'matching-rules.md 「상품명 정규화」 4단계를 거친 문자열. 코드 매칭이면 NULL']
  top1_candidate_product_id int [ref: > product.product_id, note: '유사도가 가장 높았던 상품. 없으면 NULL. 후보일 뿐 실제 매칭이 아니다']
  top1_similarity decimal [note: '그 후보의 유사도 점수. precision/scale 미정']
  failure_reason_code failure_reason_enum [not null]
  attempted_at timestamp [not null]
  status match_failure_status_enum [not null]
  related_document_id int [ref: > document.document_id, note: '있으면 연결. nullable']

  Note: '''
  매칭 실패를 건수 집계가 아니라 행 단위로 남긴다 — 문자열 조인 실패가 ETF·특정
  판매사에 몰려 표본이 한쪽으로 치우치는지, 위험등급 결측으로 잔차 회귀에서 통째로 버려지는
  상품군이 있는지 사후 검증하기 위함(scoring-and-population.md 「알려진 분석 위험」).
  임계치(matching-rules.md 「임계치」, 잠정값): 상품명 유사도 0.85 이상 자동매칭 / 0.60~0.85 수동확인 대상 /
  0.60 미만 실패. 판매사명은 별도 0.95 이상. 숫자 토큰(호수 제외)은 완전 일치 강제.
  라벨 200건으로 최종 확정 예정.
  '''
}

Table raw_object {
  raw_object_id int [pk, note: '저장한 바이트 1개 버전의 내부 키']
  document_id int [ref: > document.document_id, note: '문서 첨부만 연결. API 목록/상품/KRX 스냅숏은 NULL']
  source varchar [not null]
  source_object_key varchar [not null, note: 'source 안의 파일 식별자. 문서키+역할+첨부ID 또는 API서비스+기준일+페이지/필터']
  version_seq int [not null, note: '같은 source/source_object_key의 바이트 버전. 공시 정정 version_no와 별개']
  body_format body_format_enum [not null]
  original_file_name text
  server_path text
  download_url text [note: '인증값 제거 URL']
  source_baseline_date date
  file_role file_role_enum [not null, note: 'CDI 채점 대상을 가리는 유일한 칸 — 금투협은 문서 1건(공고)에 첨부가 2~3종이고 document_type이 "금투협 수시공시" 한 값이므로, 이 칸이 없으면 어느 파일을 채점할지 정할 자리가 없다']
  sha256 varchar(64) [not null, note: '파일 콘텐츠 해시(hex 다이제스트, 64자). storage-and-failure-rules.md 「버전·중복·재추출」의 재수집 시 버전 증가 여부·중복 저장 판정 키. 동일 바이트 검출에 사용한다. 해시가 다르더라도 요약/본문의 내용 중복은 가능하므로 대표 문서 선택을 대체하지 않는다']
  storage_path text [not null, note: 'storage-and-failure-rules.md 「파일 경로」의 raw/{source}/{원천 키}/{file_role}__v{n}.{ext} 규칙(스냅숏형 API는 원천 키 자리에 기준일). 원천 키는 source_object_key를 만드는 같은 인코딩 함수의 결과. RAW_ROOT 기준 상대경로만 저장, 절대경로 금지(09-22)']
  blob_path text [note: '2단계 데이터 파이프라인 Flow 설계 후보 칸(09-16 아키텍트 반영). CAS(blobs/{sha256 앞 2자}/{sha256}) 채택이 2단계로 미뤄져 현재는 쓰지 않는다']
  file_name text [not null, note: '원본 파일명(서버 저장명 포함)']
  content_type varchar [note: 'MIME 타입. 길이 미정']
  collected_at timestamp [not null, note: '원본 바이트 저장 완료 시각. 요청 시각은 collection_attempt']
  request_params text [not null, note: '인증값 제거 JSON. 키 원문 대신 credential_ref만; collection_attempt와 같은 규약']
  response_code varchar [note: '레거시 원문 응답 코드 보존. 판정에는 collection_attempt.http_status와 source_result_code를 각각 사용']
  collect_status collect_status_enum [not null, note: '실제 저장된 바이트 상태. 바이트 없는 요청 실패는 collection_attempt에만 기록']
  // 추출 상태는 file_extraction에 실행별로 보존한다.
  indexes {
    (source, source_object_key, version_seq) [unique]
    (raw_object_id, document_id) [unique]
  }

  Note: '''
  단위 = "원본파일 1건"(09-14 티켓 메모 반영, 구 수집_이력) — 사건(문서) 1건에 첨부가 여러 개
  붙으므로 수집·추출 성공/실패는 문서 단위가 아니라 파일 단위로 판정한다.
  DART 공개 뷰어는 cover_html + body_pdf. API ZIP은 별도 바이트로 보존하며
  ZIP 내부 구성은 미확인이다. 문서당 정확히 2행이라고 강제하지 않는다. 금투협 수시공시
  한 건은 2~3행(prospectus / prospectus_simple / change_summary)을 만든다.
  주의: 금투협은 클래스 행 N개가 같은 파일 집합을 가리킨다 — 중복 판정은 fileNm으로
  다운로드 전에 끝내고 sha256은 받은 뒤 검증용으로만 기록한다(storage-and-failure-rules.md 「금투협 클래스 행 중복 제거」).
  '''
}

//////////////////////////////////////////////////////////////////////////////
// 09-22 구체화: 09-20 결정 + 수집/추출 계보 누락 보완 (검토안)
//////////////////////////////////////////////////////////////////////////////

Table fund_group {
  fund_key varchar [pk, note: '09-20 고정 서러게이트. 이름 변경에도 유지; 상품 행을 재해싱하지 않음']
  canonical_name text [not null]
  manager_id int [ref: > distributor.distributor_id, not null]
  created_run_id varchar [ref: > pipeline_run.run_id, not null, note: '최초 발급한 EXTRACT run']
  grouping_evidence text [not null, note: 'JSON. 모자/호수/유형을 보존한 매칭 근거와 최초 원천키']
  representative_risk_grade int [note: '1~6(CHECK). 등급이 있으면 근거 문서·구분 필수(적재 검증). 작성기준일은 근거 문서의 document.report_base_date를 쓴다(중복 칼럼 없음). v2.2(10월 7일 10차 미팅 확정). 펀드 대표 위험등급 1~6. 규칙은 data-model.md 「상품과 법인」(종류형 펀드는 등급 하나). 출처가 없으면 NULL이며 통계에서 사유와 함께 제외. 반대 결정 시 이 칼럼 3개를 제거하고 product.risk_grade로 층 배정']
  risk_grade_source_document_id int [ref: > document.document_id, note: '대표 등급을 읽은 문서(어느 문서에서 왔는지). representative_risk_grade가 있으면 필수']
  risk_grade_source_kind risk_grade_source_enum [note: '간이투자설명서 표제인지 투자설명서 표지인지. 간이가 있으면 간이 우선(PM 결정)']
  indexes {
    risk_grade_source_document_id
    created_run_id
  }
  Note: '이름은 UNIQUE가 아니다. 모자 관계의 모펀드와 클래스 묶음을 동일시하지 않는다. 운용사 미확인/다중 후보는 묶음 발급 보류.'
}

Table pipeline_run {
  run_id varchar [pk, note: '실행 식별자. 같은 실행 안의 요청 재시도에는 유지하고, 실패한 채점 실행을 다시 돌릴 때는 새 run_id 발급. run_kind로 추출 실행과 채점 실행을 구분(data-model.md 「실행과 비교 모집단」)']
  run_kind run_kind_enum [not null, note: 'EXTRACT: 수집·추출·절·매칭·fund_group. SCORE: 대상·점수·모집단. 한 번의 전체 처리는 EXTRACT 1개 + 그것을 참조하는 SCORE 1개']
  upstream_run_id varchar [ref: > pipeline_run.run_id, note: 'SCORE는 필수(참조하는 EXTRACT run). EXTRACT는 NULL. 참조 대상은 SUCCEEDED인 EXTRACT run이어야 하고 baseline_date가 같아야 함(적재 검증)']
  is_official boolean [not null, default: false, note: '대시보드/API가 서빙하는 공식 채점 실행 표시. SCORE run만 true 가능, 동시에 true인 SCORE run은 최대 1개(적재 검증). EXTRACT는 항상 false. 기준일별 과거 스냅숏 서빙이 필요하면 규칙을 서빙 계약 결정(검토 번호 B5, data-model.md 「미결」)에서 확장']
  published_at timestamp [note: '마지막으로 is_official을 true로 바꾼 시각. 공식 해제 시에도 지우지 않음(게시 이력). 전체 게시/해제 로그는 2단계 데이터 파이프라인 Flow 설계의 감사 로그']
  baseline_date date [not null, note: 'SCORE run은 upstream EXTRACT run과 같은 값(적재 검증). 기준일 변경은 새 EXTRACT + 새 SCORE']
  status run_status_enum [not null, note: '실행 완료 이후 결과는 불변. 예외는 is_official/published_at 두 칼럼만(서빙 포인터, 결과 아님). is_official=true는 SUCCEEDED에서만 허용']
  config_manifest text [not null, note: 'JSON: 파서/전처리/산식/매칭 버전, 용어 사전·고지 감점표·LLM 프롬프트 버전(09-22), 축간 정규화 가중치·임계값 설정, 소스 컷오프, 소스코드 버전. EXTRACT는 파서/매칭 부분, SCORE는 산식/평가자/모집단 부분이 유효']
  config_sha256 varchar(64) [not null]
  input_manifest_path text [note: 'SCORE run은 사용한 (raw_object_id, parser_version) 목록을 고정하며 upstream EXTRACT run이 만들지 않은 이전 실행의 추출 결과·절도 허용. 사용한 raw_object 목록과 상품/매칭/위험등급/판매관계 스냅숏. 완료 실행에 필수. SCORE run은 upstream EXTRACT의 manifest 해시를 함께 기록']
  input_manifest_sha256 varchar(64)
  selection_manifest_path text [note: 'selection_manifest_path와 sha256은 함께 있거나 함께 비어야 하고 SCORE 완료 실행에는 필수(적재 검증). v2.2 병합 결과. SCORE run의 대상 선택 근거·대표본 정책 버전·펀드별 역할별 대표 문서(투자설명서 대표, 간이 대표)를 기록한 파일. RAW_ROOT 상대경로. 간이 대표 역할은 enum 없이 이 파일에 역할별로 기록(10월 4일 판단 항목, 결정 대기). EXTRACT run은 NULL']
  selection_manifest_sha256 varchar(64)
  started_at timestamp [not null]
  completed_at timestamp
  Note: '''
  09-23 v2.1(records/phase1-erd/design-review-history.md 「v2 6관점 검토」): 추출 실행과 채점 실행을 분리한다. 산식·가중치·평가자 설정만 바뀌면 새 SCORE run을
  만들고 upstream_run_id로 기존 EXTRACT run을 가리킨다. file_extraction·section을 다시 적재하지 않는다(v2.2: 같은 파일 x 파서 버전이면 파서가 바뀌지 않는 새 EXTRACT run에서도 다시 추출하지 않는다).
  파서·입력 스냅숏이 바뀌면 새 EXTRACT run과 그것을 참조하는 새 SCORE run을 만든다.
  is_official은 "지금 대시보드가 보여줄 점수"의 유일한 포인터다. MAX(completed_at) 추론을 쓰지 않는다.
  '''
}

Table collection_attempt {
  attempt_id int [pk]
  run_id varchar [not null, ref: > pipeline_run.run_id, note: 'EXTRACT run']
  source varchar [not null]
  request_key varchar [not null, note: '비밀값 제외 서비스+조회조건의 정규화 키']
  attempt_no int [not null]
  endpoint text [not null, note: '인증 쿼리/헤더 제거']
  request_params text [not null, note: 'JSON; 인증키 원문 저장 금지']
  document_id int [ref: > document.document_id]
  raw_object_id int [ref: > raw_object.raw_object_id, note: '응답 바이트 저장 시 연결. 타임아웃은 NULL; 동일 바이트 재수집은 기존 파일 재사용']
  http_status int [note: 'HTTP 응답이 없으면 NULL']
  source_result_code varchar [note: '900/030/033 등 선행 0 보존. HTTP 상태와 분리']
  result_count int
  outcome attempt_outcome_enum [not null]
  error_reason text
  attempted_at timestamp [not null]
  indexes {
    (run_id, request_key, attempt_no) [unique]
  }
  Note: '성공 빈 결과도 남긴다. raw_object는 실제 바이트의 버전, 이 표는 요청 시도. 둘의 분모가 다르다.'
}

Table file_extraction {
  raw_object_id int [not null, ref: > raw_object.raw_object_id]
  parser_version varchar [not null, note: 'v2.2. 추출 키 = 원본 파일 x 파서 버전(추출 실행 번호에서 변경). EXTRACT_OK 행이 있으면 다시 추출하지 않는다. 형식: 소문자·숫자·.-_ 만 허용(파일 경로에 쓰임). 전처리 버전을 포함한 값이다(전처리가 바뀌면 새 파서 버전). 예 pdftotext-24.02_prep-3']
  created_run_id varchar [not null, ref: > pipeline_run.run_id, note: '이 행을 마지막으로 쓴 EXTRACT run(출처 기록용, 키 아님). EXTRACT_OK 행은 불변이며 갱신하지 않는다. FAILED/PARTIAL 행은 다음 실행이 같은 키로 덮어쓸 수 있고 이때 이 칼럼을 그 실행으로 갱신한다. SCORE 입력 판별에 쓰지 않는다(입력은 SCORE run의 input manifest가 고정)']
  extract_status raw_extract_status_enum [not null]
  canonical_text_path text [note: '공통 RAW_ROOT 기준 상대경로(storage-and-failure-rules.md 「파생 텍스트·실행 스냅숏 경로」). UTF-8/LF 파일 전체 텍스트. 추출 실패 시 NULL 가능. 표/페이지 구조 보존 계약은 records/phase1-erd/design-review-history.md 「미결정 포함 재검토(09-23)」']
  canonical_text_sha256 varchar(64)
  structure_manifest_path text [note: 'RAW_ROOT 상대경로. 페이지/블록 종류/좌표/강조/텍스트 구간 대응 JSON']
  structure_manifest_sha256 varchar(64)
  structure_status structure_status_enum [not null, note: '텍스트 추출 성공과 독립. AVAILABLE/PARTIAL이면 manifest 경로·해시 필수, 그 외 NULL']
  text_length int [note: 'Unicode code point 수. 절 끝의 MAX로 전체 길이를 추정하지 않음']
  error_reason text
  extracted_at timestamp [not null]
  indexes {
    (raw_object_id, parser_version) [pk]
    created_run_id
  }
  Note: '원본 파일은 불변, 추출은 파서 버전별(v2.2). 재사용은 EXTRACT_OK 행만. FAILED/PARTIAL은 재시도 대상이라 같은 키 행을 덮어쓴다. 실행별 시도 이력은 이 표가 아니라 runs/{run_id}/extraction_attempts.jsonl에 남긴다(10월 9일). SCORE run은 upstream EXTRACT run이 만들지 않은(이전 실행이 만든) 추출 결과·절도 읽을 수 있다. EXTRACT_OK이면 텍스트 경로/해시/길이 필수. 파일 전체 텍스트를 남겨 표/요약/보일러플레이트의 지표별 처리를 가능하게 한다.'
}

Table population_snapshot {
  population_snapshot_id int [pk]
  run_id varchar [not null, ref: > pipeline_run.run_id, note: 'SCORE run']
  baseline_date date [not null, note: 'SCORE run의 baseline_date와 같아야 함(적재 검증). 칼럼 존치 여부는 data-model.md 「미결」']
  population_key varchar [not null, note: '실행 안의 층 식별자. 다른 실행에서 같은 문자열을 재사용해도 다른 스냅숏']
  observation_unit observation_unit_enum [not null, note: 'fund_section은 동일 의미 절당 펀드 하나; CDI 산식 담당 합의 전 생성 금지']
  metric_key varchar [not null, ref: > metric_definition.metric_key, note: '이 층이 어느 지표의 모집단인지. 산식·집계 범위·정규화 방식은 metric_definition.definition_manifest가 정본(v2.1에서 중복 JSON 칼럼 삭제)']
  product_category product_category_enum [not null]
  risk_grade int
  fund_type varchar
  product_class_code varchar
  stratification_definition text [not null, note: '실제 사용한 축/조건 JSON. 후보 축을 모두 자동 적용하지 않음']
  member_count int [not null, note: '클래스/절 개수가 아닌 고유 fund_key 수']
  minimum_member_count int [not null, note: '최종 층내 백분위는 09-23 조회본 기준 30. 적용 기준은 실행 설정에 고정; scoring-and-population.md 「정규화와 층내 백분위」 참조']
  excluded_count int [not null]
  exclusion_counts text [not null, note: 'JSON. PENDING/NAME_ONLY, 위험등급 결측, 판매상태 미상, 문서 충돌 등. 배정불가 상품을 임의 층에 넣지 않음']
  membership_manifest_path text [not null, note: '포함/제외 회원과 근거 파일. 정의는 data-model.md 「적재 검증 규칙」; n/평균/분위수만으로 백분위 재현 불가']
  membership_manifest_sha256 varchar(64) [not null]
  computed_at timestamp [not null]
  indexes {
    (run_id, metric_key, population_key) [unique, note: 'v2.1: 같은 실행에서 같은 층을 여러 지표가 쓸 수 있으므로 metric_key를 포함']
    (population_snapshot_id, run_id, metric_key) [unique, note: 'score 복합 FK 대상']
  }
  Note: 'run_id는 SCORE run. 층 정의(product_category, risk_grade)는 칼럼으로, 실제 구성원은 membership manifest로 보존한다.'
}

// 복합 FK: 서로 다른 문서/파서 결과가 실수로 연결되지 않게 한다.
Ref: section.(raw_object_id, parser_version) > file_extraction.(raw_object_id, parser_version)
Ref: section.(raw_object_id, document_id) > raw_object.(raw_object_id, document_id)
Ref: score.(population_snapshot_id, run_id, metric_key) > population_snapshot.(population_snapshot_id, run_id, metric_key)
Ref: score.(metric_key, target_type) > metric_definition.(metric_key, target_type)

Enum result_status_enum {
  PENDING
  OK
  NOT_APPLICABLE
  UNDETERMINED
  FAILED
}

Enum target_type_enum {
  SECTION
  DOCUMENT
  DOCUMENT_PAIR [note: 'Phase 2. 현재 저장 불가(입력 두 문서를 가리킬 칼럼 없음). 값만 유지']
  FUND
}

//////////////////////////////////////////////////////////////////////////////
// 09-23 v2.1 (records/phase1-erd/design-review-history.md 「v2 6관점 검토」): 실행 종류 분리, varchar 상태값 enum 통일, 지표 방향
// 코드값은 영문. 로더 오타가 오류 없이 통과하지 않게 한다. DB 제품별 enum 구현(PG enum vs CHECK)은 2단계 데이터 파이프라인 Flow 설계.
//////////////////////////////////////////////////////////////////////////////

Enum run_kind_enum {
  EXTRACT [note: '수집·추출·절·매칭·fund_group 발급. 파서/입력 스냅숏이 바뀌면 새 run']
  SCORE [note: '대상·점수·모집단. upstream_run_id로 EXTRACT run을 참조. 산식/평가자/모집단 기준이 바뀌면 새 run']
}

Enum run_status_enum {
  PLANNED
  RUNNING
  SUCCEEDED [note: '계획 슬롯이 모두 terminal. PENDING 점수가 남으면 SUCCEEDED로 닫지 않음(scoring-and-population.md 「결과 상태와 결측」)']
  FAILED
  CANCELLED

  // pipeline_run이 쓴다(v2.2: evaluation_run 연기). 기존 pipeline_run 값 RUNNING/SUCCEEDED/FAILED의 상위 집합.
}

Enum attempt_outcome_enum {
  SUCCESS
  EMPTY [note: '성공했으나 결과 0건. 실패가 아님']
  RETRYABLE_FAILED
  PERMANENT_FAILED
  CONFIG_ERROR
  RATE_LIMITED
}

Enum structure_status_enum {
  AVAILABLE
  PARTIAL [note: '누락 페이지/블록은 manifest의 missing_regions에 기록']
  UNAVAILABLE
  NOT_REQUESTED [note: '구조 추출을 시도하지 않음. 기존 데이터에 페이지/좌표를 가정해 채우지 않음']
}

Enum section_kind_enum {
  body
  summary
  other
}

Enum match_target_enum {
  product
  distributor
}

Enum observation_unit_enum {
  fund_document [note: '펀드당 대표 문서/파일 집계값 하나']
  fund_section [note: '동일 의미 절당 펀드 하나. CDI 산식 담당이 동등 절을 정의한 뒤에만 생성']
}

Enum normalization_status_enum {
  OK [note: '원점수 OK 및 normalized_score/모집단 필수']
  NOT_REQUESTED [note: 'normalized_score/population/reason 모두 NULL']
  UNAVAILABLE [note: 'normalized_score NULL, 사유 필수. 표본 30 미만 포함']
}

Enum metric_level_enum {
  ATOMIC
  AXIS
  COMPOSITE
  TRANSFORM
}

Enum definition_status_enum {
  DRAFT [note: '공식 OK 산출 금지. 개발 출력은 공식 점수와 분리']
  APPROVED
  RETIRED
}

Enum metric_direction_enum {
  HIGHER_IS_HARDER [note: 'CDI·ASL 등 난독성 지표. 값이 크면 어렵다']
  HIGHER_IS_BETTER [note: '고지 충실도 등. 값이 크면 좋다. 축 합산 시 방향 변환 필요(scoring-and-population.md 「CDI와 고지 충실도」)']
  NONE [note: '방향 없는 보조값(개수·길이 등)']
}

Table metric_definition {
  metric_key varchar [pk, note: '지표 ID+불변 버전. 예 asl:v1, cdi:v1. 이름 재사용으로 정의 덮어쓰기 금지']
  metric_id varchar [not null]
  version varchar [not null]
  target_type target_type_enum [not null, note: '버전 하나의 계산 단위는 하나. 단위 변경 시 새 버전']
  level metric_level_enum [not null]
  direction metric_direction_enum [not null, note: 'v2.1: JSON에서 칼럼으로 승격. 축 합산·백분위 방향 변환을 SQL에서 검증 가능하게 함']
  definition_status definition_status_enum [not null, note: 'DRAFT 결과는 공식 통계·API에 노출 금지. 승인 이력 표는 만들지 않는다(B8 채택 안 함, v2.2 수정 9). 승인 상태 변경 이력은 definition_manifest 또는 이 칼럼의 변경 기록으로 남긴다']
  definition_manifest text [not null, note: 'JSON: 단위, 산식, 분모, 입력/구조 요구, 적용범위, 결측, 집계 순서, 정규화, 승인 근거, 자산 상대경로+sha256. 방향은 direction 칼럼이 정본']
  definition_sha256 varchar(64) [not null]
  indexes {
    (metric_id, version) [unique]
    (metric_key, target_type) [unique, note: 'score 복합 FK 대상(결정 B10: score.target_type과 지표 target_type 일치)']
  }
}

Table llm_field_extraction {
  extraction_id int [pk, note: '내부 발급 서러게이트 키']
  run_id varchar [not null, ref: > pipeline_run.run_id, note: 'EXTRACT run']
  document_id int [not null, ref: > document.document_id]
  raw_object_id int [ref: > raw_object.raw_object_id, note: '파일 단위로 추출했으면 그 파일, 문서 단위면 NULL. 이번 버전은 문서 단위로 확정(raw_object_id는 참조용 NULL 허용). 파일 단위로 바꾸면 raw_object_id를 유일키에 넣는다(결정 대기, data-model.md 「v2.2」). 근거 절은 같은 문서 소속이어야 함(적재 검증)']
  field_name varchar [not null, note: '6필드 이름은 분석·리서치(민석)·데이터 사이언스(다빈)가 10월 5일 확정 전이라 값으로 둔다. 필드가 바뀌어도 표 구조는 그대로']
  attempt_no int [not null, note: '같은 run·문서·필드의 재시도 순번, 1부터']
  model_name varchar [not null, note: '실제 호출한 모델 이름']
  prompt_sha256 varchar(64) [not null, note: '프롬프트 원문 해시. 원문은 config_manifest가 가리키는 파일']
  input_sha256 varchar(64) [not null, note: '10월 9일 추가. LLM에 보낸 문서 텍스트 부분(절 선택·전처리 뒤, 프롬프트 템플릿 제외)의 UTF-8/LF 바이트 sha256. 해시 규칙과 입력 출처 목록(request.json의 inputs)은 storage-and-failure-rules.md 「LLM 호출 저장」. 재호출 생략 키의 일부']
  input_tokens int
  output_tokens int
  result_status result_status_enum [not null, note: 'OK이면 value_json 필수. 호출·파싱 실패는 FAILED. 문서에서 값을 찾지 못한 「없음」 결과는 기존 enum 값(UNDETERMINED는 판정 불가, NOT_APPLICABLE은 해당 없음)에 맞는 것이 없어 정의 보류(data-model.md 「미결」)']
  value_json text [note: '추출한 값 JSON. 값·단위·적용 클래스는 3단계 입출력 Schema 설계(io-schema.md)에서 정의']
  evidence_section_id int [ref: > section.section_id, note: '근거 위치. 결정 B11 안 1과 같은 형식 (section, char_start, char_end). 근거가 없는 필드는 NULL']
  evidence_char_start int [note: 'section과 같은 기준(canonical text의 Unicode code point 반열린 구간), 해당 절 범위 안']
  evidence_char_end int
  model_params text [note: '모델 파라미터 JSON(temperature 등)']
  raw_response_path text [note: '원응답 저장 경로. runs/{run_id}/llm/{document_id}/{field_name}/attempt-{n}/response.json. RAW_ROOT 상대경로']
  response_sha256 varchar(64) [note: 'response.json 바이트의 sha256. 채점 실행 완료 전 재대조에 쓴다']
  is_selected boolean [not null, default: false, note: '같은 문서·필드의 시도 중 최종 채택한 행. 문서·필드당 true는 최대 1개(적재 검증)']
  error_reason text
  extracted_at timestamp [not null]

  indexes {
    (run_id, document_id, field_name, attempt_no) [unique]
    (document_id, field_name, input_sha256, prompt_sha256)
    evidence_section_id
  }
  Note: '한 행 = 문서(또는 파일) x 필드 x 추출 시도. LLM 추출 시작 전 필수. 입력 특정은 input_sha256(칼럼)과 request.json의 inputs(정본). 근거가 여러 구간이면 value_json 안에 목록으로 두고 대표 구간만 칼럼에 둔다(io-schema.md 「LLM 추출 결과 JSON 요구」와 맞춰 확정).'
}

Table source_watermark {
  source varchar [not null, note: 'document.source와 같은 이름공간 또는 소스/엔드포인트 이름']
  scope_key varchar [not null, note: '비밀값 제외 서비스+조회조건의 정규화 키(collection_attempt.request_key 규약). 소스당 증분 축이 여러 개면 구분']
  covered_from date [not null, note: '누적 구간의 시작 기준일(포함). 첫 실행의 시작일로 정하고 이후 바꾸지 않음. 룩백 재조회는 이 날짜보다 앞으로 가지 않음. 구간 [covered_from, covered_through] 전체가 완전성 검증을 통과해야 한다']
  covered_through date [not null, note: '이 날짜(포함)까지 받았다고 검증된 기준일. 증분 축은 소스별(DART rcept_dt, 금투협 standardDt 등, data-sources.md)']
  verified_run_id varchar [not null, ref: > pipeline_run.run_id, note: '구간 완전성을 검증한 EXTRACT run']
  verification_note text [note: '검증 방법과 결과. 구간 완전성 검증(건수 대조, 페이지 끝 확인 등) 뒤에만 전진한다. 검증 실패·부분 응답이면 갱신하지 않고 기존 값을 유지']
  updated_at timestamp [not null]

  indexes {
    (source, scope_key) [pk]
    verified_run_id
  }
  Note: '소스별로 어디까지 받았는지의 현재 값. 갱신 순서는 storage-and-failure-rules.md 「적재 순서」를 따른다: collection_attempt 기록 -> 응답 완전성 검증 -> sha256 비교 -> S3 쓰기 -> raw_object INSERT와 attempt 갱신(한 트랜잭션) -> 구간 검증을 통과했을 때만 워터마크 전진(앞 트랜잭션과 별도 트랜잭션). 이전 값의 이력은 pipeline_run의 input manifest에 남는다. 룩백 재조회 방식과 소스별 구간 검증은 storage-and-failure-rules.md 「재시도와 워터마크」(PR #49 8절). 룩백 일수·전진 규칙은 storage-and-failure-rules.md 「재시도와 워터마크」.'
}

// 추가 검증 규칙(범위/조건부 필수/상태 조합)은 data-model.md 「절과 점수 대상」·「적재 검증 규칙」.
// 미확정: 지표별 단위/산식 승인, 고지 점수 배점/적용범위, 평가 프로토콜(표 연기), LLM 6필드 이름(10월 5일 확정 예정),
// ELS 키(Phase 1 범위 밖, 9차 미팅), 판매 중 여부 판단 근거, 법령 대응, KRX 매칭 잔여, 물리 DB/정밀도.
// 연기한 표(score_dependency, evaluation_run, evaluation_response, analysis_target_member)의 정의 요지: data-model.md 「예약 계약(승인 뒤 추가)」.
