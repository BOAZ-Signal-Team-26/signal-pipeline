# 인증키 템플릿. 실제 값은 .env 에 넣는다 (.gitignore 처리됨).
#   cp .env.example .env
#
# 키 이름은 「필요 데이터 6종 API Key 발급 및 수집 테스트」(주영, 09-02 완료)가
# 정한 것을 그대로 쓴다. 이름을 바꾸면 주영의 samples/ 스크립트와 어긋난다.

# 공공데이터포털 펀드상품기본정보 (data.go.kr)
#   신청: https://www.data.go.kr/tcs/dss/selectApiDataDetailView.do?publicDataPk=15094792
#   API : https://apis.data.go.kr/1160100/service/GetFundProductInfoService/getStandardCodeInfo
#   주의: Decoding 키를 쓴다. Encoding 키(%3D%3D 로 끝남)를 그대로 URL 인코딩하면 403이 난다
DATA_GO_KR_API_KEY=

# KRX Open API
#   API : http://data-dbg.krx.co.kr/svc/apis/etp/etf_bydd_trd
#   인증: AUTH_KEY 헤더
KRX_API_KEY=

# 금감원 검사결과제재 · 경영유의사항 공시 (09-21 발급)
#   API : https://www.fss.or.kr/fss/kr/openApi/api/openInfo.jsp (검사결과제재)
#         https://www.fss.or.kr/fss/kr/openApi/api/openInfoImpr.jsp (경영유의사항 등)
#   주의: 응답 인코딩이 euc-kr이다. utf-8로 읽으면 한글이 전부 깨진다
#   주의: 일일 조회 30회. sanction·impr 두 엔드포인트가 같은 한도를 공유한다
#   주의: 개인용 키는 한 번에 최대 1개월치만 조회된다
FSS_API_KEY=

# 아래 3종은 검증 2에 쓰지 않는다. 같은 .env 를 공유하므로 이름만 남겨 둔다.
FINLIFE_API_KEY=
OPENDART_API_KEY=
LAW_API_OC=

# 원본·실행 기록·워터마크를 저장하는 공통 루트. 비밀값 아님
#   이 아래에 raw/(원본), runs/(실행 기록), state/(워터마크)가 생긴다
#   저장소 밖 경로를 권장(본문 PDF 500건이면 약 1GB). 비어 있으면 크롤러가 실행되지 않는다
#   규칙: docs/storage-and-failure-rules.md 「원본 보관」
RAW_ROOT=
